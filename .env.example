# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# SQLite by default (zero setup). For PostgreSQL, change `provider` in
# prisma/schema.prisma to "postgresql" and point this at your server:
#   DATABASE_URL="postgresql://user:pass@localhost:5432/quoteflow?schema=public"
DATABASE_URL="file:./dev.db"

# Public origin, used for Stripe redirect URLs.
APP_URL="http://localhost:3000"

# Keys the session-token HMAC. Required in production; at least 32 characters.
#   openssl rand -base64 48
SESSION_SECRET=""

# ---------------------------------------------------------------------------
# AI drafting (optional). Without it the app runs and quotations are written
# by hand; the AI panel says so instead of pretending to work.
# ---------------------------------------------------------------------------
AI_PROVIDER="none"          # "anthropic" | "none"
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5"
AI_MAX_OUTPUT_TOKENS="4000"

# ---------------------------------------------------------------------------
# Payments (optional). Without it the Pro upgrade button is replaced by an
# explanation; no workspace is ever silently marked as paid.
# ---------------------------------------------------------------------------
BILLING_PROVIDER="none"     # "stripe" | "none"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_PRO=""

# ---------------------------------------------------------------------------
# Scheduled maintenance (optional). Bearer token for /api/cron/reminders,
# which expires stale quotations and returns due follow-ups.
# ---------------------------------------------------------------------------
CRON_SECRET=""
