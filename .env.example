# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# SQLite by default (zero setup). For PostgreSQL, change `provider` in
# prisma/schema.prisma to "postgresql" and point this at your server:
#   DATABASE_URL="postgresql://user:pass@localhost:5432/quoteflow?schema=public"
DATABASE_URL="file:./dev.db"

# Public origin, used for Stripe redirect URLs.
APP_URL="http://localhost:3000"

# Keys the session-token HMAC, the portal-token hash and the IP hashes used in
# the audit log. Required in production; at least 32 characters. Obvious
# placeholders ("changeme", "secret", repeated characters) are refused.
#   openssl rand -base64 48
SESSION_SECRET=""

# ---------------------------------------------------------------------------
# Request handling
# ---------------------------------------------------------------------------

# Whether a trusted proxy rewrites `x-forwarded-for`. Leave true behind a load
# balancer or PaaS that overwrites it. Set false when the app is exposed
# directly: a spoofable header would let one caller mint a fresh rate-limit
# bucket per request, so untrusted deployments share a single bucket instead.
TRUST_PROXY_HEADERS="true"

# Fleet-wide kill switch for shareable quotation pages and customer portals.
# Set false to make every existing link report "not available" immediately.
PUBLIC_PAGES_ENABLED="true"

# Smoke-testing a production build on your own machine. Only ever relaxes the
# http://localhost case — an http URL on a real hostname is still refused.
# Never set this on a deployed server.
ALLOW_INSECURE_LOCAL="false"

# ---------------------------------------------------------------------------
# AI drafting (optional). Without it the app runs and quotations are written
# by hand; the AI panel says so instead of pretending to work.
# ---------------------------------------------------------------------------
AI_PROVIDER="none"          # "anthropic" | "none"
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5"
AI_MAX_OUTPUT_TOKENS="4000"

# ---------------------------------------------------------------------------
# Payments (optional). Without it the Pro upgrade button is replaced by an
# explanation; no workspace is ever silently marked as paid.
# ---------------------------------------------------------------------------
BILLING_PROVIDER="none"     # "stripe" | "none"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_PRO=""

# ---------------------------------------------------------------------------
# Scheduled maintenance (optional). Bearer token for /api/cron/reminders,
# which expires lapsed quotations, prunes rate-limit rows and returns the
# follow-ups now due. It does not deliver anything — the response says so.
# ---------------------------------------------------------------------------
CRON_SECRET=""
