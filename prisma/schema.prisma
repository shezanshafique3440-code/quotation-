// QuoteFlow AI — multi-tenant schema.
//
// Portability: no DB-level enums and no Decimal columns, so the same schema
// runs on SQLite (default, zero-config) and PostgreSQL. To move to Postgres,
// change `provider` to "postgresql" and point DATABASE_URL at the server.
// All money is stored as integer minor units (cents) to avoid float drift.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]
  sessions    Session[]
  quotations  Quotation[] @relation("QuotationAuthor")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Billing / plan state. `plan` is "free" | "pro" (see src/lib/plans.ts).
  plan                 String    @default("free")
  planStatus           String    @default("active")
  planRenewsAt         DateTime?
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique

  profile     BusinessProfile?
  memberships Membership[]
  sessions    Session[]
  customers   Customer[]
  inquiries   Inquiry[]
  products    Product[]
  quotations  Quotation[]
  reminders   Reminder[]
  usageEvents UsageEvent[]
  templates   QuotationTemplate[]
  events      ActivityEvent[]
  portalTokens CustomerPortalToken[]
  emails      EmailDelivery[]
}

model BusinessProfile {
  id             String @id @default(cuid())
  organizationId String @unique

  legalName      String
  currency       String  @default("USD")
  locale         String  @default("en-US")
  email          String?
  phone          String?
  whatsappNumber String?
  website        String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  postalCode     String?
  country        String?
  taxId          String?
  // Default tax rate in basis points (1250 = 12.50%).
  taxRateBp      Int     @default(0)
  logoUrl        String?
  quoteNumberPrefix String @default("QT")
  defaultValidityDays Int  @default(14)
  defaultTerms   String?
  defaultNotes   String?

  /// IANA zone (e.g. "Europe/Berlin"). Every date shown to a user and every
  /// end-of-day expiry boundary is resolved in this zone, not the server's.
  timezone       String  @default("UTC")

  // Branding applied to the shareable quote page, the portal and the PDF.
  brandColor     String  @default("#4B3DDB")
  portalHeadline String?
  portalMessage  String?

  // Quote-to-close defaults, overridable per quotation.
  publicPagesEnabled   Boolean @default(true)
  requireSignature     Boolean @default(false)
  autoFollowUpEnabled  Boolean @default(true)
  autoFollowUpDays     Int     @default(3)

  // Which outbound emails this workspace wants. Sending is only ever
  // attempted when a provider is configured; see src/lib/email.ts.
  /// Address replies go to, and where owner notifications are delivered.
  notifyEmail          String?
  notifyOnView         Boolean @default(false)
  notifyOnDecision     Boolean @default(true)
  notifyFollowUpsDue   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  // "owner" | "admin" | "member"
  role           String   @default("owner")
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Session {
  // Primary key is a SHA-256 hash of the cookie token; the raw token is never stored.
  id             String   @id
  userId         String
  organizationId String
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  company        String?
  email          String?
  phone          String?
  whatsapp       String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inquiries    Inquiry[]
  quotations   Quotation[]
  events       ActivityEvent[]
  portalTokens CustomerPortalToken[]
  emails       EmailDelivery[]

  @@index([organizationId, name])
}

model Inquiry {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String
  // "whatsapp" | "email" | "phone" | "web" | "walk_in" | "other"
  channel        String   @default("whatsapp")
  subject        String
  message        String
  // "new" | "quoted" | "won" | "archived"
  status         String   @default("new")
  receivedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  quotations   Quotation[]

  @@index([organizationId, status])
  @@index([customerId])
}

model Product {
  id             String   @id @default(cuid())
  organizationId String
  sku            String?
  name           String
  description    String?
  unitPriceCents Int
  unit           String   @default("unit")
  taxRateBp      Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items         QuotationItem[]
  templateItems QuotationTemplateItem[]

  @@unique([organizationId, sku])
  @@index([organizationId, active])
}

model Quotation {
  id             String  @id @default(cuid())
  organizationId String
  number         String
  customerId     String
  inquiryId      String?
  createdById    String?

  // "draft" | "sent" | "accepted" | "rejected" | "expired"
  status   String @default("draft")
  title    String
  currency String @default("USD")

  subtotalCents Int @default(0)
  discountCents Int @default(0)
  taxCents      Int @default(0)
  totalCents    Int @default(0)

  notes String?
  terms String?

  validUntil DateTime?
  sentAt     DateTime?
  decidedAt  DateTime?

  /// Share-link token. Stored in the clear because the owner must be able to
  /// re-copy the link; it is revocable and only ever grants read + respond on
  /// this one quotation. Disabling `publicEnabled` blocks it immediately.
  publicToken   String?   @unique
  publicEnabled Boolean   @default(false)
  publicOpenedAt DateTime?

  // Engagement, recorded from real page views of the share link only.
  firstViewedAt DateTime?
  lastViewedAt  DateTime?
  viewCount     Int       @default(0)

  // Customer decision, distinct from the owner moving the status by hand.
  decisionSource  String?
  respondedAt     DateTime?
  respondedByName String?
  rejectionReason String?

  // Optional typed e-signature captured on the share page.
  requireSignature Boolean   @default(false)
  signatureName    String?
  signatureEmail   String?
  signedAt         DateTime?
  /// HMAC of the signer's IP — evidentiary without storing the address itself.
  signatureIpHash  String?

  /// Reporting currency and the rate recorded when the quote was written.
  /// Null rate means "not converted"; analytics exclude it rather than guess.
  baseCurrency       String?
  exchangeRateToBase Float?

  templateId String?

  // Provenance of the draft: null when hand-written, otherwise the model id used.
  aiModel     String?
  aiGenerated Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  inquiry      Inquiry?        @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  createdBy    User?           @relation("QuotationAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  template     QuotationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  items        QuotationItem[]
  reminders    Reminder[]
  events       ActivityEvent[]
  emails       EmailDelivery[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([customerId])
}

model QuotationItem {
  id          String  @id @default(cuid())
  quotationId String
  productId   String?

  position       Int
  description    String
  quantity       Float  @default(1)
  unit           String @default("unit")
  unitPriceCents Int
  taxRateBp      Int    @default(0)
  lineTotalCents Int    @default(0)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quotationId])
}

model Reminder {
  id             String @id @default(cuid())
  organizationId String
  quotationId    String

  // "whatsapp" | "email" | "call"
  channel String   @default("whatsapp")
  // "pending" | "done" | "cancelled"
  status  String   @default("pending")
  dueAt   DateTime
  note    String?

  /// True when the system scheduled this after the quote was sent, rather
  /// than a person adding it. Auto follow-ups are cancelled on a decision.
  autoCreated Boolean @default(false)
  /// A drafted follow-up message. Drafted only; QuoteFlow never sends it.
  messageDraft String?

  /// When this reminder last went out in a follow-up digest to the owner.
  /// Set only after a provider accepted the email, so a failed digest is
  /// retried on the next run instead of being silently swallowed. It also
  /// stops an hourly scheduler from mailing the same item every hour.
  digestedAt DateTime?

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotation    Quotation    @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, dueAt])
}

model UsageEvent {
  id             String   @id @default(cuid())
  organizationId String
  // "ai_draft" | "quotation_created"
  kind           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, kind, createdAt])
}

/// A reusable starting point for a quotation: default terms, validity,
/// signature policy and a set of pre-priced lines.
model QuotationTemplate {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  description    String?
  isDefault      Boolean @default(false)

  titlePattern     String?
  notes            String?
  terms            String?
  validityDays     Int     @default(14)
  requireSignature Boolean @default(false)
  currency         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        QuotationTemplateItem[]
  quotations   Quotation[]

  @@unique([organizationId, name])
  @@index([organizationId, isDefault])
}

model QuotationTemplateItem {
  id         String @id @default(cuid())
  templateId String
  productId  String?

  position       Int
  description    String
  quantity       Float  @default(1)
  unit           String @default("unit")
  unitPriceCents Int
  taxRateBp      Int    @default(0)

  template QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  product  Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([templateId])
}

/// Append-only record of everything that happened, used for three things:
/// the per-quotation timeline, the per-customer timeline, and the security
/// audit log. `category` separates them; rows are never updated or deleted
/// by application code.
model ActivityEvent {
  id             String @id @default(cuid())
  organizationId String

  /// "quotation" | "customer" | "security" | "billing" | "settings"
  category String
  /// Specific event name, e.g. "quotation.viewed" (see src/lib/activity.ts).
  kind     String

  /// "user" | "customer" | "system" | "anonymous"
  actorType  String
  actorId    String?
  actorLabel String

  quotationId String?
  customerId  String?

  summary  String
  /// JSON blob of event-specific detail. Never holds secrets.
  metadata String?

  /// HMAC of the request IP — correlatable without storing the address.
  ipHash    String?
  userAgent String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotation    Quotation?   @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, category, createdAt])
  @@index([quotationId, createdAt])
  @@index([customerId, createdAt])
}

/// Passwordless access to the customer portal. The primary key is an HMAC of
/// the link token, so the database never holds a usable link.
model CustomerPortalToken {
  id             String    @id
  organizationId String
  customerId     String
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  lastUsedAt     DateTime?
  revokedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, revokedAt])
  @@index([expiresAt])
}

/// Fixed-window rate limit counters. Living in the database means the limit
/// is shared across instances instead of being per-process.
model RateLimitCounter {
  key          String   @id
  count        Int      @default(0)
  windowEndsAt DateTime

  @@index([windowEndsAt])
}


/// Every outbound email attempt, successful or not.
///
/// This table is the reason the product can say "sent" truthfully: a row only
/// reaches `sent` when a provider accepted the message and returned an id.
/// A failure is recorded with its error and surfaced to the user, never
/// swallowed into a success message.
model EmailDelivery {
  id             String @id @default(cuid())
  organizationId String

  /// "quotation" | "accepted" | "declined" | "follow_up_digest" | "portal_link"
  kind      String
  /// "queued" | "sent" | "failed"
  status    String @default("queued")
  provider  String

  toEmail   String
  /// Copy of the subject as actually sent, for the audit trail.
  subject   String

  quotationId String?
  customerId  String?

  /// Provider-side id, present only on a genuine success.
  providerMessageId String?
  /// Provider or transport error, present only on a failure.
  error             String?

  attempts   Int       @default(0)
  sentAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotation    Quotation?   @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([quotationId])
  @@index([status, createdAt])
}
